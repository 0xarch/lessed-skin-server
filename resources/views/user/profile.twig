{% extends 'user.base' %}

{% block title %}{{ trans('general.profile') }}{% endblock %}

{% block content %}
  {{ include('shared.grid') }}

  <form id="modal-delete-account-form">
    <mdui-dialog id="modal-delete-account"
      close-on-overlay-click
      close-on-esc
      headline="{{trans('user.profile.delete.modal-title')}}"
    >
      <div>
        <div>{{ trans('user.profile.delete.modal-notice')|nl2br|raw }}</div>
        <br>
        <mdui-text-field type="password" required name="password"
          placeholder="{{ trans('user.profile.delete.password') }}" autocomplete="current-password">
        </mdui-text-field>
      </div>
      <mdui-button slot="action" type="button" variant="text" onclick="document.getElementById('modal-delete-account').open=false">
        {{ trans('general.close') }}
      </mdui-button>
      <mdui-button slot="action" type="submit">
        {{ trans('general.submit') }}
      </mdui-button>
    </mdui-dialog>
  </form>
{% endblock %}
