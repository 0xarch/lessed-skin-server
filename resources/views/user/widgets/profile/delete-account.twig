<mdui-card class="md-card mdui-prose">
  <h3 class="card-title">
    {{ trans('user.profile.delete.title') }}
  </h3>
  {% if user.permission %}
    <p>{{ trans('user.profile.delete.admin') }}</p>
  {% else %}
    <p>{{ trans('user.profile.delete.notice', { site: site_name }) }}</p>
  {% endif %}

  {% if user.permission %}
    <mdui-button disabled>
      {{ trans('user.profile.delete.button') }}
    </mdui-button>
  {% else %}
    <mdui-button
      data-toggle="modal"
      data-target="#modal-delete-account"
    >
      {{ trans('user.profile.delete.button') }}
    </mdui-button>
  {% endif %}
</mdui-card>
