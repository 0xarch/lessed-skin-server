<mdui-card class="md-card mdui-prose">
  <form method="post" id="change-password">
    <h3>
      {{ trans('user.profile.password.title') }}
    </h3>
    <mdui-text-field type="password"
      name="oldPassword" required
      autocomplete="current-password"
      toggle-password
      variant="outlined"
      label="{{ trans('user.profile.password.old') }}"
    ></mdui-text-field>
    <br class="md-br"/>
    <mdui-text-field type="password"
      name="newPassword" required
      toggle-password
      variant="outlined"
      label="{{ trans('user.profile.password.new') }}"
      autocomplete="new-password"
      minlength="8" maxlength="32"
    ></mdui-text-field>
    <br class="md-br"/>
    <mdui-text-field type="password"
      name="confirm" required
      toggle-password
      variant="outlined"
      label="{{ trans('user.profile.password.confirm') }}"
      autocomplete="new-password"
      minlength="8" maxlength="32"
    ></mdui-text-field>
    <br class="md-br"/>
    <mdui-button type="submit">
      {{ trans('user.profile.password.button') }}
    </mdui-button>
  </form>
</mdui-card>
