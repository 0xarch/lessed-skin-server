<mdui-card class="md-card mdui-prose">
  <form method="post" id="change-nickname">
    <h3>
      {{ trans('user.profile.nickname.title') }}
    </h3>
    <mdui-text-field type="text"
      name="nickname" required
      value="{{ user.nickname }}"
      label="{{ trans('user.profile.nickname.title') }}"
      variant="outlined"
    ></mdui-text-field>
    <br class="md-br">
    <mdui-button type="submit">
      {{ trans('general.submit') }}
    </mdui-button>
  </form>
</mdui-card>
