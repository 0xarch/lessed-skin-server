<mdui-card class="md-card mdui-prose">
  <form method="post" id="change-email">
    <h3 class="card-title">
      {{ trans('user.profile.email.title') }}
    </h3>
    <mdui-text-field type="email" name="email" required
      value="{{ user.email }}"
      label="{{ trans('user.profile.email.new') }}"
      variant="outlined"
    ></mdui-text-field>
    <hr class="md-br"/>
    <mdui-text-field type="password" name="password" required
      value="{{ user.email }}"
      label="{{ trans('user.profile.email.password') }}"
      autocomplete="current-password"
      toggle-password
      variant="outlined"
    ></mdui-text-field>
    <hr class="md-br">
    <mdui-button type="submit">
      {{ trans('user.profile.email.button') }}
    </mdui-button>
  </form>
</mdui-card>
