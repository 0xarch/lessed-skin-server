<f-card id="announcement-box">
  <f-card-header>
    <h3>{{ trans('user.announcement') }}</h3>
  </f-card-header>
  <f-card-body>
    {{ announcement|raw }}
  </f-card-body>
  {% if auth_user().permission %}
    <f-card-footer>
      <a href="{{ url('/admin/options') }}">
        <i class="fas fa-edit"></i>
      </a>
    </f-card-footer>
  {% endif %}
</f-card>