<mdui-card id="announcement-box" class="md-card mdui-prose">
  <h3>{{ trans('user.announcement') }}</h3>
  <mdui-divider class="md-br"></mdui-divider>
  <div>
    {{ announcement|raw }}
  </div>
  {% if auth_user().permission %}
    <mdui-divider class="md-br"></mdui-divider>
      <mdui-button-icon href="{{ url('/admin/options') }}" icon="edit">
      </mdui-button-icon>
  {% endif %}
</mdui-card>
