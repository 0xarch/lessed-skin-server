<mdui-top-app-bar scroll-behavior="elevate" scroll-target="mdui-layout-main">
  <mdui-button-icon id="sidebar-toggle-button" icon="menu"></mdui-button-icon>
  <mdui-button-icon icon="home" href="{{ url('/') }}"></mdui-button-icon>
  <mdui-top-app-bar-title class="brand-link">{{ site_name }}</mdui-top-app-bar-title>

  <div style="flex-grow: 1"></div>
  
  <ul class="navbar-nav ml-auto">
    {% if auth_check() %}
      {{ include('shared.notifications', { design: 'mdui' }) }}
      {# {{ include('shared.languages') }} #}
      {{ include('shared.user-menu', { design: 'mdui' }) }}
    {% else %}
      <li class="nav-item">
        <a class="nav-link" href="{{ url('auth/login') }}">
          <i class="icon fas fa-sign-in"></i>
          {{ trans('general.login') }}
        </a>
      </li>
    {% endif %}
  </ul>
</mdui-top-app-bar>
