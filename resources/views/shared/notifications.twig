{% if design == 'mdui' %}
  <mdui-dropdown id="notifications_container">
    <mdui-button icon="{{ notifications|length ? 'notifications' : 'notifications_none' }}" variant="text" slot="trigger">
      {% if notifications|length %}
        <mdui-badge>{{ notifications|length}}</mdui-badge>
      {% else %}
        {{ trans('user.no-unread') }}
      {% endif %}
    </mdui-button>
    <mdui-menu dense>
      {% for item in notifications %}
          <mdui-menu-item data-notification-id="{{ item.id }}" class="notification-item">{{ item.title }}</mdui-menu-item>
      {% endfor %}
      {% if not notifications|length %}
        <mdui-menu-item class="no-notifications">
          {{ trans('user.no-unread') }}
        </mdui-menu-item>
      {% endif %}
    </mdui-menu>
  </mdui-dropdown>
{% else %}
  <li
    class="nav-item dropdown"
    data-t="{{ trans('user.no-unread') }}"
    data-notifications="{{ notifications|json_encode }}"
  >
  </li>
{% endif %}