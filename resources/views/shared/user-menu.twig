<mdui-dropdown>
  <mdui-button variant="elevated" class="topbar-avatar-button" slot="trigger">
    <mdui-avatar slot="icon">
      <picture>
        <source srcset="{{ avatar }}" type="image/webp">
        <img src="{{ avatar_png }}" alt="User Image">
      </picture>
    </mdui-avatar>
    {{ user.nickname ?? user.email }}
  </mdui-button>
  <mdui-menu>
    {% for item in menu %}
      {% if item.link == '#divider' %}
        <mdui-divider></mdui-divider>
      {% else %}
        <mdui-menu-item href="{{ item.link }}">{{ item.label }}</mdui-menu-item>
      {% endif %}
    {% endfor %}
    <mdui-divider></mdui-divider>
    <mdui-menu-item href="#" id="logout-button">
      {{ trans('general.logout') }}
    </mdui-menu-item>
  </mdui-menu>
</mdui-dropdown>
