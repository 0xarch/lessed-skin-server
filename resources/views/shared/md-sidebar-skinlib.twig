<mdui-navigation-drawer close-on-overlay-click id="main-sidebar">
  {% if scope == 'user' %}
    {% if auth_check() %}
      {{ include('shared.user-panel') }}
    {% endif %}
    <mdui-list style="margin: 0 .5rem">
      {% if auth_check() %}
        <mdui-list-item icon="upload" href="{{ url('skinlib/upload') }}" rounded>
          {{ trans('skinlib.general.upload-new-skin') }}
        </mdui-list-item>
      {% else %}
        <mdui-list-item icon="upload" disabled rounded>
          {{ trans('skinlib.general.upload-new-skin') }}
        </mdui-list-item>
      {% endif %}
      {% if auth_check() %}
        <mdui-collapse value="user">
          <mdui-collapse-item value="user">
            <mdui-list-item slot="header" icon="admin_panel_settings" end-icon="expand_more" rounded>
              {{ trans('general.user-center') }}
            </mdui-list-item>
            <div style="margin-left: 2.5rem">
              {{ include('shared.side-menu', {type: 'user', design: 'mdui'}) }}
            </div>
          </mdui-collapse-item>
        </mdui-collapse>
      {% endif %}
      <mdui-collapse value="explore">
        <mdui-collapse-item value="explore">
          <mdui-list-item slot="header" icon="explore" end-icon="expand_more" rounded>
            {{ trans('general.explore') }}
          </mdui-list-item>
          <div style="margin-left: 2.5rem">
            {{ include('shared.side-menu', {type: 'explore', design: 'mdui'}) }}
            {% if auth_user().permission %}
              <mdui-list-item href="{{ url('admin') }}" icon="admin_panel_settings" rounded>{{ trans('general.admin-panel') }}</mdui-list-item>
            {% endif %}
          </div>
        </mdui-collapse-item>
      </mdui-collapse>
    </mdui-list>
  {% elseif scope == 'admin' %}
    {{ include('shared.user-panel') }}
    <mdui-list style="margin: 0 .5rem">
      <mdui-collapse value="admin">
        <mdui-collapse-item value="admin">
          <mdui-list-item slot="header" icon="admin_panel_settings" end-icon="expand_more" rounded>
            {{ trans('general.admin-panel') }}
          </mdui-list-item>
          <div style="margin-left: 2.5rem">
            {{ include('shared.side-menu', {type: 'admin', design: 'mdui'}) }}
          </div>
        </mdui-collapse-item>
      </mdui-collapse>
      <mdui-list-item href="{{ url('user') }}" icon="dashboard" rounded>{{ trans('general.user-center') }}</mdui-list-item>
      <mdui-list-item href="{{ url('skinlib') }}" icon="archive" rounded>{{ trans('general.skinlib') }}</mdui-list-item>
    </mdui-list>
  {% endif %}
</mdui-navigation-drawer>
