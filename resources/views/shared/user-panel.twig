<div style="margin: 0 1rem">
  <div class="d-flex">
    <mdui-button variant="elevated" class="topbar-avatar-button">
      <mdui-avatar slot="icon">
        <picture>
          <source srcset="{{ avatar }}" type="image/webp">
          <img src="{{ avatar_png }}" alt="User Image">
        </picture>
      </mdui-avatar>
      {{ user.nickname ?? user.email }}
    </mdui-button>
  </div>


  <div class="d-flex flex-wrap" style="margin-top: 1rem">
    {% for badge in badges %}
      <mdui-badge>{{ badge.text }}</mdui-badge>
    {% endfor %}
  </div>
  <mdui-divider style="margin: .5rem 0"></mdui-divider>
</div>