<!DOCTYPE html>
<html lang="{{ locale }}" class="mdui-theme-auto mdui-prose">
  <head>
    {{ include('shared.head') }}
    <link rel="preload" as="image" href="{{ home_pic_url }}">
    <title>{{ site_name }}</title>
    <style>
      body {
        background-color: rgb(var(--mdui-color-primary-container)) !important;
        color: rgb(var(--mdui-color-on-primary-container)) !important;
      }
      .hp-wrapper {
        {% if home_pic_url %}
          background-image: url('{{ home_pic_url }}');
        {% else %}
          background-image: linear-gradient(var(--accent-color-75),var(--accent-color-25))
        {% endif %}
      }
    </style>
    {{ include('assets.home-css', ignore_missing = true) }}
  </head>

  <body class="hold-transition layout-top-nav">
    <mdui-layout style="height: 100vh">
      <mdui-top-app-bar>
        <mdui-top-app-bar-title>
          <a href="{{ url('/') }}" class="navbar-brand brand-link">{{ site_name }}</a>
        </mdui-top-app-bar-title>

        <div style="flex-grow: 1"></div>

        {% if auth_check() %}
          {{ include('shared.notifications', { design: 'mdui' }) }}
          {# {{ include('shared.languages') }} #}
          {{ include('shared.user-menu', { design: 'mdui' }) }}
        {% else %}
          <mdui-button href="{{ url('auth/login') }}" variant='text' icon='login'>{{ trans('general.login') }}</mdui-button>
          <mdui-button href="{{ url('auth/register') }}" variant='outlined' icon='app_registration'>{{ trans('general.register') }}</mdui-button>
        {% endif %}
      </mdui-top-app-bar>
      <mdui-layout-main class="d-flex flex-column align-items-center">
        <section class="content" style="flex: 1">
          <div class="d-flex flex-column align-items-center"">
            <h1 class="splash-head">{{ site_name }}</h1>
            <p class="splash-subhead">
              {{ site_description }}
            </p>
            {% if auth_check() %}
              <mdui-button href="{{ url('user') }}">
                {{ trans('general.user-center') }}
              </mdui-button>
            {% else %}
              <a href="{{ url('auth/register') }}">
                {{ trans('general.register') }}
              </a>
            {% endif %}
          </div>
        </section>
        <footer style="margin-top: 1rem">
          {{ include('shared.copyright') }}
        </footer>
      </mdui-layout-main>
    </mdui-layout>

    <script type="application/json" id="blessing-extra">
      {{ {transparent_navbar: transparent_navbar}|json_encode|raw }}
    </script>
    {{ include('assets.home', ignore_missing = true) }}
    {{ include('shared.foot') }}
  </body>
</html>
