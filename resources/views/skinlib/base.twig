<!DOCTYPE html>
<html lang="{{ locale }}" class="mdui-theme-auto">
  <head>
    {{ include('shared.head') }}
    <title>{% block title %}{% endblock %} - {{ site_name }}</title>
  </head>

  <body>
    <mdui-layout style="height: 100vh">
      {{ include('shared.md-header') }}
      {{ include('shared.md-sidebar-skinlib', {scope: 'user'}) }}

      <mdui-layout-main class="d-flex flex-column content-wrapper">
        {% block content %}{% endblock %}
        <footer style="margin-top: 1rem">
          {{ include('shared.copyright') }}
        </footer>
      </mdui-layout-main>
    </mdui-layout>
    {% block before_foot %}{% endblock %}
    {{ include('shared.foot') }}
  </body>
</html>
