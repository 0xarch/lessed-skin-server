<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    {{ include('shared.head') }}
    <title>{% block title %}{% endblock %} - {{ site_name }}</title>
  </head>

  <body>
    <mdui-layout style="height: 100vh">
      {{ include('shared.md-header') }}
      {{ include('shared.md-sidebar', {scope: 'admin'}) }}
      <mdui-layout-main class="d-flex flex-column">
        <div class="content-header">
          <div class="container-fluid">
            <div class="d-flex justify-content-between flex-wrap">
              <div>
                <h1 class="m-0">{{ block('title') }}</h1>
              </div>
              <div>
                <div class="breadcrumb"></div>
              </div>
            </div>
          </div>
        </div>
        <section class="content" style="flex: 1">
          <div class="container-fluid">
            {% block content %}{% endblock %}
          </div>
        </section>
        <footer style="margin-top: 1rem">
          {{ include('shared.copyright') }}
        </footer>
      </mdui-layout-main>
    </mdui-layout>
    {% block before_foot %}{% endblock %}
    {{ include('shared.foot') }}
  </body>
</html>
