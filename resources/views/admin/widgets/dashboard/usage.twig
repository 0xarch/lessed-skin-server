<div class="row">
  <div class="col-md-6">
    <div class="card immersive">
      <div class="card-header inlined">
        <div class="card-icon"><i class="fas fa-users"></i></div>
        <h2 class="card-title stats large">{{ sum.users }}</h2>
        <p class="card-subtitle">{{ trans('admin.index.total-users') }}</p>
      </div>
      <div class="card-footer">
        <a href="{{ url('admin/users') }}" class="btn">
          {{ trans('general.user-manage') }}
        </a>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card immersive">
      <div class="card-header inlined">
        <div class="card-icon"><i class="fas fa-gamepad"></i></div>
        <h2 class="card-title stats large">{{ sum.players }}</h2>
        <p class="card-subtitle">{{ trans('admin.index.total-players') }}</p>
      </div>
      <div class="card-footer">
        <a href="{{ url('admin/players') }}" class="btn">
          {{ trans('general.player-manage') }}
        </a>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card immersive">
      <div class="card-header inlined">
        <div class="card-icon"><i class="fas fa-file"></i></div>
        <h3 class="card-title stats large">{{ sum.textures }}</h3>
        <p class="card-subtitle">{{ trans('admin.index.total-textures') }}</p>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card immersive">
      <div class="card-header inlined">
        <div class="card-icon"><i class="fas fa-hdd"></i></div>
        {% if sum.storage > 1024 %}
          <h3 class="card-title stats large">{{ (sum.storage / 1024)|round(1) }}MB</h3>
        {% else %}
          <h3 class="card-title stats large">{{ sum.storage }}KB</h3>
        {% endif %}
        <p class="card-subtitle">{{ trans('admin.index.disk-usage') }}</p>
      </div>
    </div>
  </div>
</div>
