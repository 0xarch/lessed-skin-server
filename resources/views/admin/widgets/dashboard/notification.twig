<mdui-card class="md-card mdui-prose">
  <h3 class="card-title">{{ trans('admin.notifications.send.title') }}</h3>
  <form method="post" action="{{ url('/admin/notifications/send') }}">
    {{ csrf_field() }}
    <div class="card-body">
      {% if errors.any %}
        <div class="callout callout-danger">{{ errors.first }}</div>
      {% endif %}
      {% set sent_result = session_pull('sentResult') %}
      {% if sent_result %}
        <div class="callout callout-success">{{ sent_result }}</div>
      {% endif %}
      <h4>{{ trans('admin.notifications.receiver.title') }}</h4>
      <br class="md-br">
      <mdui-radio-group name="receiver" required>
        <mdui-radio value="all" class="d-flex">{{ trans('admin.notifications.receiver.all') }}</mdui-radio>
        <mdui-radio value="normal" class="d-flex">{{ trans('admin.notifications.receiver.normal') }}</mdui-radio>
        <mdui-radio value="uid" class="d-flex md-radio-unclickable-control">
          <mdui-text-field label="{{ trans('admin.notifications.receiver.uid') }}" type="number" name="uid" variant="outlined"></mdui-text-field>
        </mdui-radio>
        <mdui-radio value="email" class="d-flex md-radio-unclickable-control">
          <mdui-text-field label="{{ trans('admin.notifications.receiver.email') }}" type="email" name="email" variant="outlined"></mdui-text-field>
        </mdui-radio>
      </mdui-radio-group>
      <div class="form-group">
        {# <label>{{ trans('admin.notifications.receiver.title') }}</label> #}
        {# <div class="radio">
        <label>
          <input type="radio" name="receiver" value="all" required>
          {{ trans('admin.notifications.receiver.all') }}
        </label>
        </div>
        <div class="radio">
          <label>
            <input type="radio" name="receiver" value="normal" required>
            {{ trans('admin.notifications.receiver.normal') }}
          </label>
        </div> #}
        {# <div class="radio">
          <label>
            <input type="radio" name="receiver" value="uid" required>
            {{ trans('admin.notifications.receiver.uid') }} &nbsp;
            <input type="number" name="uid" class="form-control">
          </label>
        </div>
        <div class="radio">
          <label>
            <input type="radio" name="receiver" value="email" required>
            {{ trans('admin.notifications.receiver.email') }} &nbsp;
            <input type="email" name="email" class="form-control">
          </label>
        </div> #}
      </div>
    </div>
    <mdui-text-field label="{{ trans('admin.notifications.title') }}" type="text" name="title" variant="outlined"></mdui-text-field>
    <br class="md-br">
    <mdui-text-field label="{{ trans('admin.notifications.content') }}" type="text" name="content" rows="4"></mdui-text-field>
    <br class="md-br">
    <mdui-button
      type="submit"
    >
      {{ trans('general.submit') }}
    </mdui-button>
  </form>
</mdui-card>
