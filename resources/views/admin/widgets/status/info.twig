<f-card>
  <f-card-header>
    <h3>{{ trans('admin.status.info') }}</h3>
  </f-card-header>
  <f-card-body>
    <table class="mdui-table">
      <tbody>
        {% for category, info in detail %}
          <tr>
            <th colspan="2">{{ trans("admin.status.#{category}.name") }}</th>
          </tr>
          {% for key, value in info %}
            <tr>
              <td>{{ trans("admin.status.#{category}.#{key}") }}</td>
              <td>{{ value }}</td>
            </tr>
          {% endfor %}
        {% endfor %}
      </tbody>
    </table>
  </f-card-body>
</f-card>
