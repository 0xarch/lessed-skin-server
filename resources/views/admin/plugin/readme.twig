{% extends 'admin.base' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
  <f-card>
    <f-card-header>
      <h3>{{ trans('admin.plugins.readme') }}</h3>
    </f-card-header>
    <f-card-body>{{ content|raw }}</f-card-body>
    <f-card-footer>
      <button class="btn bg-primary" onclick="history.back()">
        {{ trans('general.back') }}
      </button>
    </f-card-footer>
  </f-card>
{% endblock %}
