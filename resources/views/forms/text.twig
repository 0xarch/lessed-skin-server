<mdui-text-field
  type="text"
  name="{{ id }}"
  value="{{ value}}"
  label="{{ label }}"
  {{ disabled ? 'disabled' : '' }}
  placeholder="{{ placeholder }}"
  variant="outlined"
  style="{{ hidden ? 'display: none !important' }}"
>
{% if suffix %}
<div slot="end-icon" style="font-size: medium">{{ suffix }}</div>
{% endif %}
</mdui-text-field>
