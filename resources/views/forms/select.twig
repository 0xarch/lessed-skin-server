<mdui-select
  name="{{ id }}"
  {{ disabled ? 'disabled=disabled' : '' }}
  label="{{ label }}"
  value= "{{ selected }}"
  variant="outlined"
>
  {% for option in options %}
    <mdui-menu-item
      value="{{ option.value }}"
    >
      {{ option.name }}
    </mdui-menu-item>
  {% endfor %}
</mdui-select>
