<div style="width: 100%">
  <label style="margin-left: .5rem">{{ label }}</label>
  <mdui-range-slider
    {{ value ? 'checked="true"' : '' }}
    id="{{ id }}"
    name="{{ id }}"
    min="{{ min }}"
    max="{{ max }}"
    step="{{ step }}"
    value="true"
    value-min-name="{{ minname }}"
    value-max-name="{{ maxname }}"
  ></mdui-range-slider>
</div>
