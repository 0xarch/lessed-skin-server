{% extends 'auth.base' %}

{% block title %}{{ trans('auth.login.title') }}{% endblock %}

{% block content %}
  <div class="card-body login-card-body">
    {% for row in rows %}
      {{ include(row) }}
    {% endfor %}
  </div>
{% endblock %}

{% block before_foot %}
  <script id="blessing-extra" type="application/json">
    {{ extra|json_encode|raw }}
  </script>
{% endblock %}
